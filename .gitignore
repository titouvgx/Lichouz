# Dépendances et build
node_modules
dist
*.local

# Variables d'environnement : seul .env.example est versionné
.env
.env.*
!.env.example

# Supabase CLI (fichiers locaux)
supabase/.temp
supabase/.branches

# Éditeurs et système
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.log

# SQL assemblé pour une installation neuve (npm run prod:sql)
supabase/prod/sortie/

# Sauvegardes de la base : jamais dans le dépôt (données personnelles)
sauvegardes/
*-roles.sql
*-schema.sql
*-data.sql
*.7z
